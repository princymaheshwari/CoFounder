# Convex backend secrets. Set with `npx convex env set NAME value` (see scripts/set-env.sh).
# Never commit real values. Never put these in Creao Secrets.
# capi_ account key from agent.creao.ai → Settings → API Keys (NOT a developer.creao.ai cr_sk_ key)
CREAO_API_KEY=
CREAO_WEBHOOK_TOKEN=
NESSIE_API_KEY=
APIFY_TOKEN=
APIFY_WEBHOOK_TOKEN=
CO_TOKEN_SECRET=

# Frontend (Vite) — public, safe to expose
VITE_CONVEX_URL=
